{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.2.0"}],
  "title": "E-HealthCard — Monitoring Médical (Sujet 5)",
  "uid": "ehealthcard-v1",
  "tags": ["ehealthcard", "medical", "sujet5"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "type": "stat", "title": "🔥 Requêtes/sec (Rate)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}, "unit": "reqps"}},
      "targets": [{"expr": "sum(rate(health_http_requests_total[1m]))", "legendFormat": "Req/sec"}]
    },
    {
      "id": 2, "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "type": "stat", "title": "❌ Taux d'Erreurs 5xx",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.02}, {"color": "red", "value": 0.05}]}, "unit": "percentunit"}},
      "targets": [{"expr": "sum(rate(health_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(health_http_requests_total[5m]))", "legendFormat": "Erreurs 5xx"}]
    },
    {
      "id": 3, "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "type": "stat", "title": "⚡ Latence Médiane API",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 0.2}]}, "unit": "s"}},
      "targets": [{"expr": "histogram_quantile(0.50, sum(rate(health_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"}]
    },
    {
      "id": 4, "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "type": "stat", "title": "👥 Patients Synchronisés",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}, "unit": "short"}},
      "targets": [{"expr": "health_synced_patients_total", "legendFormat": "Patients"}]
    },
    {
      "id": 5, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "type": "timeseries", "title": "📈 Latence de Synchronisation des Constantes Médicales",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(health_http_request_duration_seconds_bucket{endpoint=\"/api/vitals/sync\"}[2m])) by (le))", "legendFormat": "p50 — Constantes"},
        {"expr": "histogram_quantile(0.95, sum(rate(health_http_request_duration_seconds_bucket{endpoint=\"/api/vitals/sync\"}[2m])) by (le))", "legendFormat": "p95 — Constantes"},
        {"expr": "histogram_quantile(0.99, sum(rate(health_http_request_duration_seconds_bucket{endpoint=\"/api/vitals/sync\"}[2m])) by (le))", "legendFormat": "p99 — Constantes"}
      ],
      "alert": {
        "alertRuleTags": {},
        "conditions": [{"evaluator": {"params": [0.2], "type": "gt"}, "operator": {"type": "and"}, "query": {"params": ["A", "5m", "now"]}, "reducer": {"params": [], "type": "avg"}, "type": "query"}],
        "executionErrorState": "alerting",
        "for": "1m",
        "frequency": "15s",
        "handler": 1,
        "message": "Latence API Urgence dépasse 200ms !",
        "name": "Latence Urgence Critique",
        "noDataState": "no_data"
      }
    },
    {
      "id": 6, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "type": "timeseries", "title": "🔄 Synchronisations de Symptômes par Minute",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"legend": {"calcs": ["sum", "last"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 15}}},
      "targets": [
        {"expr": "sum(increase(health_symptom_sync_total{status=\"success\"}[1m]))", "legendFormat": "✅ Synchros réussies"},
        {"expr": "sum(increase(health_symptom_sync_total{status=\"error\"}[1m]))", "legendFormat": "❌ Synchros en erreur"},
        {"expr": "sum(increase(health_symptom_sync_total{status=\"failed_auth\"}[1m]))", "legendFormat": "🔐 Auth refusée"}
      ]
    },
    {
      "id": 7, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "type": "timeseries", "title": "🔒 Temps de Chiffrement des Payloads Médicaux",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s", "custom": {"lineWidth": 2}}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(health_api_encryption_duration_seconds_bucket{operation=\"encrypt\"}[2m])) by (le, endpoint))", "legendFormat": "p95 Chiffrement — {{endpoint}}"},
        {"expr": "histogram_quantile(0.95, sum(rate(health_api_encryption_duration_seconds_bucket{operation=\"decrypt\"}[2m])) by (le, endpoint))", "legendFormat": "p95 Déchiffrement — {{endpoint}}"}
      ]
    },
    {
      "id": 8, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "type": "timeseries", "title": "🚨 Latence API Urgence (Seuil critique : 200ms)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": [{"matcher": {"id": "byName", "options": "Seuil critique 200ms"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}, {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}]}]
      },
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(health_http_request_duration_seconds_bucket{endpoint=\"/api/emergency\"}[2m])) by (le))", "legendFormat": "p95 — /api/emergency"},
        {"expr": "histogram_quantile(0.99, sum(rate(health_http_request_duration_seconds_bucket{endpoint=\"/api/emergency\"}[2m])) by (le))", "legendFormat": "p99 — /api/emergency"},
        {"expr": "vector(0.200)", "legendFormat": "Seuil critique 200ms"}
      ]
    },
    {
      "id": 9, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "type": "gauge", "title": "🔐 Taux d'Accès Refusés (Non Autorisés)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.10}, {"color": "red", "value": 0.20}]}, "unit": "percentunit", "min": 0, "max": 1}},
      "targets": [{"expr": "sum(rate(health_auth_requests_total{status=\"rejected\"}[5m])) / sum(rate(health_auth_requests_total[5m]))", "legendFormat": "% Refusés"}]
    },
    {
      "id": 10, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "type": "gauge", "title": "🖥️ CPU Serveur (%)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}, "unit": "percent", "min": 0, "max": 100}},
      "targets": [{"expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %"}]
    },
    {
      "id": 11, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "type": "gauge", "title": "💾 Mémoire RAM Utilisée (%)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}, "unit": "percent", "min": 0, "max": 100}},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "RAM %"}]
    },
    {
      "id": 12, "gridPos": {"h": 6, "w": 24, "x": 0, "y": 28},
      "type": "timeseries", "title": "📶 Synchros Offline → Online (Post-Déconnexion)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 20}}},
      "targets": [
        {"expr": "sum(increase(health_offline_sync_reconnect_total{data_type=\"profile\"}[5m]))", "legendFormat": "Profil médical"},
        {"expr": "sum(increase(health_offline_sync_reconnect_total{data_type=\"vitals\"}[5m]))", "legendFormat": "Constantes vitales"},
        {"expr": "sum(increase(health_offline_sync_reconnect_total{data_type=\"symptoms\"}[5m]))", "legendFormat": "Symptômes"},
        {"expr": "sum(increase(health_offline_sync_reconnect_total{data_type=\"symptoms_batch\"}[5m]))", "legendFormat": "Symptômes (batch)"}
      ]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "links": [],
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1
}
